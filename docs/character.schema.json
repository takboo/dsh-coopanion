{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "dsh-character"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 500
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "motion": {
      "default": {
        "breathe": 0.015,
        "bob": 2,
        "walkBounce": 3,
        "happyBounce": 8
      },
      "type": "object",
      "properties": {
        "breathe": {
          "default": 0.015,
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "bob": {
          "default": 2,
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "walkBounce": {
          "default": 3,
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "happyBounce": {
          "default": 8,
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "renderer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "image": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^assets\\/[a-zA-Z0-9_./-]+\\.(png|webp)$"
            }
          },
          "required": [
            "type",
            "image"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "spritesheet"
            },
            "image": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^assets\\/[a-zA-Z0-9_./-]+\\.(png|webp)$"
            },
            "frameWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "frameHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "animations": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "idle",
                  "thinking",
                  "working",
                  "waiting",
                  "happy",
                  "error",
                  "sleeping",
                  "walk",
                  "dragged",
                  "poke"
                ]
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "frames": {
                    "minItems": 1,
                    "maxItems": 256,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1023
                    }
                  },
                  "fps": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "loop": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "image",
            "frameWidth",
            "frameHeight",
            "columns",
            "rows",
            "animations"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "layers"
            },
            "layers": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,47}$"
                  },
                  "image": {
                    "type": "string",
                    "maxLength": 160,
                    "pattern": "^assets\\/[a-zA-Z0-9_./-]+\\.(png|webp)$"
                  },
                  "parent": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,47}$"
                  },
                  "x": {
                    "default": 0,
                    "type": "number",
                    "minimum": -4096,
                    "maximum": 4096
                  },
                  "y": {
                    "default": 0,
                    "type": "number",
                    "minimum": -4096,
                    "maximum": 4096
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "pivotX": {
                    "default": 0.5,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "pivotY": {
                    "default": 0.5,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "rotation": {
                    "default": 0,
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  "scaleX": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 5
                  },
                  "scaleY": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 5
                  },
                  "opacity": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "id",
                  "image",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            },
            "animations": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "idle",
                  "thinking",
                  "working",
                  "waiting",
                  "happy",
                  "error",
                  "sleeping",
                  "walk",
                  "dragged",
                  "poke"
                ]
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "durationMs": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 60000
                  },
                  "loop": {
                    "default": true,
                    "type": "boolean"
                  },
                  "tracks": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "layer": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,47}$"
                        },
                        "property": {
                          "type": "string",
                          "enum": [
                            "x",
                            "y",
                            "rotation",
                            "scaleX",
                            "scaleY",
                            "opacity"
                          ]
                        },
                        "keys": {
                          "minItems": 1,
                          "maxItems": 64,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "at": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "value": {
                                "type": "number",
                                "minimum": -4096,
                                "maximum": 4096
                              },
                              "easing": {
                                "default": "linear",
                                "type": "string",
                                "enum": [
                                  "linear",
                                  "smooth"
                                ]
                              }
                            },
                            "required": [
                              "at",
                              "value"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "layer",
                        "property",
                        "keys"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "durationMs",
                  "tracks"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "layers",
            "animations"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "author",
    "license",
    "canvas",
    "renderer"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/takboo/dsh-coopanion/main/docs/character.schema.json",
  "title": "DSH Character Pack v1"
}
